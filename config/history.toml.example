# auto-speech speech history: every line played, kept as a WAV and a sidecar,
# up to max_gb on disk. The one WAV store: Spoken Transcript reads it, never writes it.
#
# Copy to ~/.config/auto-speech/history.toml and edit, or point
# AUTO_SPEECH_HISTORY_CONFIG=/path/to/file.toml at a custom one.
# `auto-speech history …` and the MCP tool `history` write this same file,
# with the same names. The daemon reads it on every line. Defaults shown.
# The lines live in ~/.local/state/auto-speech/history/ ($AUTO_SPEECH_HISTORY_DIR).

[history]
# The switch. true: each line heard is copied into the history with its
# sidecar (text, time, sender, priority, duration, word timings).
# false: nothing is exported; what is kept stays.
enabled = true

# The most the store may hold on disk, in GB. After each export the oldest
# lines are deleted until it fits (and at once when this is lowered). 20 GB
# is about 21,000 lines at the measured mean clip (ADR-020).
max_gb = 20

# How many of the newest lines the player's history view and
# `auto-speech history list` show. It deletes nothing.
keep = 200

# Open the UI Utility's player on each line after it plays. Never during a
# meeting or while another app's sound holds speech; nothing happens while
# the utility is not installed.
player = false
