# auto-speech narrator configuration.
#
# Copy to ~/.config/auto-speech/narrator.toml and edit as needed.
# Or point AUTO_SPEECH_NARRATOR_CONFIG=/path/to/file.toml at a custom one.
#
# Default values shown.

[narrator]
# Provider: "mlx" (Apple Silicon native, in-process), "ollama" (uses
# the Ollama HTTP API at 127.0.0.1:11434 — no model loaded in our
# process), "mock" (templated, no LLM).
# Future: "openai" / "anthropic".
#
# Default ships as "mock" so installing the plugin never triggers a
# 2 GB model download by surprise. Run /auto-speech-narrate-install to
# install mlx-lm + pull the default model, which also flips this to "mlx".
# Or set provider = "ollama" + model = "qwen2.5:3b" if you already
# run Ollama and want to skip the in-process model.
provider = "mock"

# Model identifier for the chosen provider.
# For MLX: any HuggingFace mlx-community model id.
# Suggested starting points (small + fast on M-series):
#   "mlx-community/Qwen2.5-3B-Instruct-4bit"
#   "mlx-community/Llama-3.2-3B-Instruct-4bit"
model = "mlx-community/Qwen2.5-3B-Instruct-4bit"

# Path to the prompt template. Relative paths resolve against the
# directory of this config file. The template gets four named
# substitutions: {category}, {count}, {duration}, {events}.
prompt_template = "narrator_prompt_newscaster.txt"

# Cap on generated tokens per phase summary.
max_tokens = 60

# A phase closes if this many seconds pass with no new event.
silence_seconds = 8.0

# Daemon auto-shuts-down after this many seconds with no events.
idle_shutdown_seconds = 600.0

# Minimum tool calls in a phase before we narrate it. Default 1
# (narrate everything except suppressed categories). Raise to 2 or 3
# if the narration is too chatty for your workflow. Raising it past
# the typical per-turn tool count will silence the narrator entirely.
min_events_per_phase = 1

# Maximum phases buffered ahead of the (playback-bound) TTS worker.
# When a burst of phases outruns playback, the daemon sheds the OLDEST
# queued phase rather than grow memory without bound; every drop is
# logged with a running total. Default 32.
max_queue_depth = 32

# Budgets that keep one line from holding the queue forever (2026-10-19: one
# synthesis sat in the model for five hours and nothing after it was heard).
# A synthesis may take this many times the line's spoken length, never under
# 30 s; a play may run the clip's length plus this margin. A line past its
# budget is set aside on the missed list (`auto-speech missed`) and the next
# plays. 0 turns a budget off.
synthesis_timeout_factor = 3.0
play_timeout_margin_seconds = 15.0

# Speech under load (ADR-019, 2026-10-20: a load of 272 on 16 cores timed five
# lines out and cut one off mid-sentence). A play is never cut off while the
# clip is still advancing: the sink reads mpv's position and ends a play only
# after play_stall_seconds with no progress (0 turns the stall watch off; the
# wall-clock budget above then applies). Synthesis and wall-clock budgets grow
# with the load per core, up to load_timeout_scale_cap times (0: no growth).
# A line that still times out is queued again up to timeout_retries times;
# each retry first waits (up to retry_wait_seconds) for the load per core to
# fall under retry_load_per_core, then plays the whole line. Only after the
# last retry is it set aside on the missed list.
play_stall_seconds = 15.0
load_timeout_scale_cap = 4.0
timeout_retries = 3
retry_load_per_core = 2.0
retry_wait_seconds = 180.0

# Optional: override the Ollama API host. Only used when provider="ollama".
# Defaults to AUTO_SPEECH_OLLAMA_HOST env var, then http://127.0.0.1:11434.
# ollama_host = "http://127.0.0.1:11434"
