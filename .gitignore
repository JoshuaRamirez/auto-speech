# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment (managed by setup/install.sh)
.venv/

# Install-time sentinel + per-machine self-update stamp (lock hash last synced)
setup/.installed
setup/.synced

# Per-machine calibration history (profile itself IS committed as a sample)
config/calibration_history.jsonl

# Per-machine replay cache (audio, not source of truth)
config/cache/

# Large test artifacts — WAVs are regenerable; keep logs and text
tests/outputs/**/*.wav

# macOS
.DS_Store

# Per-developer Claude Code project state (settings.local.json, narrator
# enable marker, etc.) — never project-wide.
.claude/

# Reports and local plugin remember state
reports/
plugins/**/.remember/
.remember/
# Agents' teamwork logs: local only, none published (they hold private paths; #m1021-1314-d03d)
.agents/teamwork/
# Agents' working files: local only, not needed publicly (#m1021-1314-d03d)
/PROJECT.md
/TEST_READY.md
